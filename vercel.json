{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/admin/subscriptions/expiry-checker",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/admin/subscriptions/payment-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/admin/analytics/aggregate",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/admin/cleanup",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/admin/cleanup/hard-delete-tenants",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/admin/subscriptions/process-scheduled-downgrades",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin/sales/automate",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/admin/cleanup/pre-deletion-warnings",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/admin/analytics/send-scheduled-reports",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/admin/onboarding/image-retry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/admin/integrations/tumizi/provision-pending",
      "schedule": "*/5 * * * *"
    }
  ]
}

