# ============================================
# DukaNest Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in your values
# Command: Copy-Item env.template .env.local
# DO NOT commit .env.local to version control

# ============================================
# Supabase Configuration (REQUIRED)
# ============================================
# Get these from: Supabase Dashboard → Settings → API

# Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public Key (Safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (NEVER expose in client-side code - server-side only!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Authentication → URL Configuration → Redirect URLs must allow tenant OAuth/callback URLs
# (e.g. https://*.yourdomain.com/auth/callback**, tenant login flows), plus localhost equivalents.

# Database Connection String
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ============================================
# Mobile / Flutter Web CORS (Optional)
# ============================================
# Comma-separated list of allowed Origin values for browser clients calling
# /api/v1/mobile/*, /api/tenants/register, /api/tenants/check-subdomain
# Example: https://app.yourdomain.com,http://localhost:57777
# If unset in production, only listed origins get Access-Control-Allow-Origin.
# Development: any Origin is allowed for those routes.
# MOBILE_CORS_ORIGINS=

# ============================================
# Vercel Configuration (Optional - for deployment)
# ============================================
# Get these from: Vercel Dashboard → Project → Settings → General

# Your Vercel deployment URL
VERCEL_URL=your-app.vercel.app

# Vercel API Token (for domain management)
# Get from: Vercel Dashboard → Settings → Tokens
VERCEL_TOKEN=your-vercel-token-here

# Vercel Project ID
# Get from: Vercel Dashboard → Project → Settings → General
VERCEL_PROJECT_ID=your-project-id-here

# ============================================
# Application Configuration
# ============================================

# Application URL (for local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: absolute URL for placeholder images during onboarding until real assets exist.
# Defaults to /images/onboarding-product-placeholder.svg (same origin).
# NEXT_PUBLIC_ONBOARDING_PLACEHOLDER_IMAGE_URL=https://your-cdn.example/placeholder.png

# Application Name
NEXT_PUBLIC_APP_NAME=DukaNest

# Base Domain (for tenant subdomains)
# Example: dukanest.com (tenants will be tenant1.dukanest.com)
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000

# Meta Pixel (Optional - for Facebook/Meta ads conversion tracking)
# Get from: Meta Business Suite → Events Manager → Data Sources → Add Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel + Events API (Optional - for TikTok ads conversion tracking)
# Get from: TikTok Ads Manager → Tools → Events → Web Events
NEXT_PUBLIC_TIKTOK_PIXEL_ID=D6N7BVBC77UE81ODK9A0
TIKTOK_ACCESS_TOKEN=
# Optional override (defaults to TikTok v1.3 track endpoint)
TIKTOK_EVENTS_API_URL=
# Optional debug logging for server-side TikTok events (use only in development)
TIKTOK_EVENTS_API_DEBUG=false

# ============================================
# Payment Gateways (Optional)
# ============================================

# Pesapal Configuration (Primary - Kenya)
# Get from: https://www.pesapal.com/ → Dashboard → API Credentials
# Supports: M-Pesa, Cards, Mobile Money, Bank Transfers
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_ENVIRONMENT=sandbox  # or 'live' for production
# IPN URL for subscription payments (register once; then set PESAPAL_NOTIFICATION_ID from response)
# Use HTTPS in production so PesaPal can reach the IPN
PESAPAL_IPN_URL=https://yourdomain.com/api/pesapal/subscription/ipn
# Notification ID from RegisterIPN (after registering PESAPAL_IPN_URL with PesaPal)
PESAPAL_NOTIFICATION_ID=
# Yearly billing discount (e.g. 17 = 17% off, "2 months free")
PESAPAL_YEARLY_DISCOUNT_PERCENT=17

# PayPal Configuration (Optional - for international)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox  # or 'live' for production

# ============================================
# Email Configuration (Optional)
# ============================================
# Choose one: Resend (recommended) or SendGrid

# Option 1: Resend (Recommended)
RESEND_API_KEY=re_...

# Option 2: SendGrid
# SENDGRID_API_KEY=SG...
# SENDGRID_FROM_EMAIL=noreply@dukanest.com

# SMTP Configuration (Alternative)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM=noreply@dukanest.com

# ============================================
# SMS — Ujumbe (https://ujumbesms.co.ke) (Optional)
# ============================================
# Server-side only. Used for: registration welcome (optional adminPhone),
# new-order alert to merchant (store phone in dashboard settings),
# subscription payment/renewal reminders (same store phone).
# tenants.country (ISO2, e.g. KE) + lib/sms/iso-dial-codes.ts drive formatting — no extra DB table required.

UJUMBE_SMS_API_URL=https://ujumbesms.co.ke/api/messaging
UJUMBE_SMS_X_AUTHORIZATION=NTUyNTk3ZTk0NTRiOTE2YzE3YTk1MmMxMjI5MTZl
UJUMBE_SMS_EMAIL=muragewanjohi@gmail.com
UJUMBE_SMS_SENDER=UJUMBESMS
# Optional: URL for delivery webhooks from Ujumbe
# UJUMBE_SMS_DELIVERY_REPORT_URL=https://yourdomain.com/api/webhooks/sms/ujumbe

# ============================================
# Mobile Push Notifications (FCM v1 / APNs) (Optional)
# ============================================
# FCM HTTP v1 credentials (service account). Required for Android/Web push.
# Create a service account in Firebase/Google Cloud with Firebase Messaging access.
# Store FIREBASE_PRIVATE_KEY as a single-line env var using \n for line breaks.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# iOS relay endpoint (if you use external APNs relay for iOS tokens)
APNS_PUSH_URL=
APNS_AUTH_TOKEN=

# ============================================
# File Storage (Supabase Storage)
# ============================================

# Supabase Storage Bucket Name
NEXT_PUBLIC_STORAGE_BUCKET=dukanest-uploads

# ============================================
# Caching (Vercel KV / Redis) (Optional)
# ============================================
# Get from: Vercel Dashboard → Storage → KV

# Vercel KV (Redis)
KV_URL=your-kv-url
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your-kv-token

# ============================================
# Development & Debugging
# ============================================

# Node Environment
NODE_ENV=development

# Enable Debug Mode
NEXT_PUBLIC_DEBUG=false

# Log Level
LOG_LEVEL=info  # debug, info, warn, error

# ============================================
# Security (Optional)
# ============================================

# Encryption Key (for sensitive data)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here

# JWT Secret (if using custom JWT)
JWT_SECRET=your-jwt-secret-here

# ============================================
# Notes
# ============================================
# 
# 1. NEVER commit .env.local to version control
# 2. .env.local is already in .gitignore
# 3. Use this template as a reference
# 4. For production, set these in Vercel Dashboard → Settings → Environment Variables
# 5. Supabase keys with NEXT_PUBLIC_* are safe to expose in client-side
# 6. Service role key should NEVER be exposed client-side
# 
# ============================================

