# ============================================
# DukaNest Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in your values
# Command: Copy-Item env.template .env.local
# DO NOT commit .env.local to version control

# ============================================
# Supabase Configuration (REQUIRED)
# ============================================
# Get these from: Supabase Dashboard → Settings → API

# Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public Key (Safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (NEVER expose in client-side code - server-side only!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connection String (Pooled - for queries)
# Format: postgresql://postgres.[project-ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Get from: Supabase Dashboard → Settings → Database → Connection string → Connection pooling
# Use this for regular application queries (more efficient, connection pooling)
DATABASE_URL=postgresql://postgres.gtybtfngnggakrsbtrfw:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Database Connection (for migrations)
# Format: postgresql://postgres.[project-ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Get from: Supabase Dashboard → Settings → Database → Connection string → Direct connection
# Use this for Prisma migrations (direct connection, port 5432)
DIRECT_URL=postgresql://postgres.gtybtfngnggakrsbtrfw:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# ============================================
# Vercel Configuration (Optional - for deployment)
# ============================================
# Get these from: Vercel Dashboard → Project → Settings → General

# Your Vercel deployment URL
VERCEL_URL=your-app.vercel.app

# Vercel API Token (for domain management)
# Get from: Vercel Dashboard → Settings → Tokens
VERCEL_TOKEN=your-vercel-token-here

# Vercel Project ID
# Get from: Vercel Dashboard → Project → Settings → General
VERCEL_PROJECT_ID=your-project-id-here

# ============================================
# Application Configuration
# ============================================

# Application URL (for local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Name
NEXT_PUBLIC_APP_NAME=DukaNest

# Base Domain (for tenant subdomains)
# Example: dukanest.com (tenants will be tenant1.dukanest.com)
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000

# Default Tenant Subdomain (for localhost development)
# When accessing localhost:3000, use this tenant subdomain
# Example: teststore (will look for tenant with subdomain 'teststore')
DEFAULT_TENANT_SUBDOMAIN=teststore

# ============================================
# Payment Gateways (Optional)
# ============================================

# M-Pesa Buy Goods (Till Number) Configuration
# Get from: https://developer.safaricom.co.ke/ → Create App → Get Credentials
# Request Till Number from Safaricom for Buy Goods
# Documentation: https://developer.safaricom.co.ke/apis
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-till-number  # e.g., 300584 (your Buy Goods Till Number)
MPESA_PASSKEY=your-mpesa-passkey  # Provided by Safaricom for your Till Number
MPESA_ENVIRONMENT=sandbox  # or 'production' for live payments

# M-Pesa API URLs (usually don't need to change)
MPESA_BASE_URL_SANDBOX=https://sandbox.safaricom.co.ke
MPESA_BASE_URL_PRODUCTION=https://api.safaricom.co.ke

# Pesapal Configuration (Primary - Kenya)
# Get from: https://www.pesapal.com/ → Dashboard → API Credentials
# Supports: M-Pesa, Cards, Mobile Money, Bank Transfers
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_ENVIRONMENT=sandbox  # or 'live' for production
# Use HTTPS in production so PesaPal can reach the IPN
PESAPAL_IPN_URL=https://yourdomain.com/api/pesapal/subscription/ipn
# Shared token appended to provider callback URLs and required by payment callback routes.
PAYMENT_WEBHOOK_TOKEN=change-this-to-a-long-random-token

# ============================================
# Tumizi Partner Gateway (Optional)
# ============================================
# Enable per-store wallet and automatic payment verification via Tumizi
TUMIZI_BASE_URL=https://app.tumizi.africa
TUMIZI_PARTNER_API_KEY=tipk_...

# PayPal Configuration (Optional - for international)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox  # or 'live' for production

# ============================================
# Email Configuration (REQUIRED for 2FA)
# ============================================
# Resend is the primary email service provider
# Get your API key from: https://resend.com/api-keys

# Resend API Key (REQUIRED)
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get from: Resend Dashboard → API Keys
RESEND_API_KEY=re_...

# Resend From Email (REQUIRED)
# Must be under a verified domain in Resend
RESEND_FROM_EMAIL=noreply@dukanest.com

# Resend From Name (Optional)
# Display name for emails (defaults to "Dukanest" if not set)
RESEND_FROM_NAME=DukaNest

# ============================================
# Backward Compatibility (Optional)
# ============================================
# Legacy SendGrid env names are still accepted by code:
# SENDGRID_API_KEY=SG...
# SENDGRID_FROM_EMAIL=noreply@dukanest.com
# SENDGRID_FROM_NAME=DukaNest

# ============================================
# Mobile Push Notifications (FCM v1 / APNs) (Optional)
# ============================================
# FCM HTTP v1 credentials (service account). Required for Android/Web push.
# Create a service account in Firebase/Google Cloud with Firebase Messaging access.
# Store FIREBASE_PRIVATE_KEY as a single-line env var using \n for line breaks.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# iOS relay endpoint (if you use external APNs relay for iOS tokens)
APNS_PUSH_URL=
APNS_AUTH_TOKEN=

# ============================================
# File Storage (Supabase Storage)
# ============================================

# Supabase Storage Bucket Name
# Create this bucket in Supabase Dashboard → Storage
# Make sure to enable "Public bucket" so images can be accessed via public URLs
NEXT_PUBLIC_STORAGE_BUCKET=product-images

# ============================================
# Caching (Vercel KV - Alternative) (Optional)
# ============================================
# Get from: Vercel Dashboard → Storage → KV

# Vercel KV (Redis)
KV_URL=your-kv-url
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your-kv-token

# ============================================
# Development & Debugging
# ============================================

# Node Environment
NODE_ENV=development

# Enable Debug Mode
NEXT_PUBLIC_DEBUG=false

# Log Level
LOG_LEVEL=info  # debug, info, warn, error

# ============================================
# Play Store Reviewer MFA Bypass (Temporary)
# ============================================
# Use ONLY during Google Play review with dedicated account.
# Recommended account: playreview@dukanest.com
# Keep disabled unless review is in progress.
PLAY_REVIEW_BYPASS_ENABLED=false
PLAY_REVIEW_BYPASS_EMAIL=playreview@dukanest.com
# ISO timestamp, example: 2026-05-30T23:59:59Z
PLAY_REVIEW_BYPASS_UNTIL=

# ============================================
# Google Maps API (Required for Address Autocomplete)
# ============================================
# Get from: Google Cloud Console → APIs & Services → Credentials
# See docs/GOOGLE_MAPS_SETUP.md for detailed setup instructions
# 
# Steps:
# 1. Create Google Cloud project: https://console.cloud.google.com/
# 2. Enable "Maps JavaScript API" and "Places API"
# 3. Create API key in Credentials section
# 4. Restrict key to your domains and APIs
# 5. Link billing account (required, but $200/month free credit)
# 6. Add key here

# Google Maps API Key (REQUIRED for checkout address autocomplete)
# Format: AIzaSy... (long alphanumeric string)
# Get from: Google Cloud Console → APIs & Services → Credentials → Create API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# Analytics (Optional)
# ============================================

# Google Analytics 4 (GA4) Measurement ID
# Get from: Google Analytics Dashboard → Admin → Data Streams → Web Stream → Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Security (Optional)
# ============================================

# Encryption Key (for sensitive data)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here

# JWT Secret (if using custom JWT)
JWT_SECRET=your-jwt-secret-here

# ============================================
# Notes
# ============================================
# 
# 1. NEVER commit .env.local to version control
# 2. .env.local is already in .gitignore
# 3. Use this template as a reference
# 4. For production, set these in Vercel Dashboard → Settings → Environment Variables
# 5. Supabase keys with NEXT_PUBLIC_* are safe to expose in client-side
# 6. Service role key should NEVER be exposed client-side
# 
# ============================================

